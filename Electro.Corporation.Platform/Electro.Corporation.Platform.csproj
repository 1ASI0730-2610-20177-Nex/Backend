<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <!-- Version Framework -->
        <TargetFramework>net10.0</TargetFramework>

        <!-- Activa advertencias para los null-->
        <Nullable>enable</Nullable>

        <!-- Agrega using automaticamente haciendo codigo limpio -->
        <ImplicitUsings>enable</ImplicitUsings>

        <!-- Habilita la globalizacion para usar formatos de fechas, numeros, monedas e idiomas -->
        <InvariantGlobalization>false</InvariantGlobalization>

        <!-- Compila en C#14 -->
        <LangVersion>14</LangVersion>

    </PropertyGroup>


    <ItemGroup>
        <!-- ============================================ -->
        <!-- Entity Framework Core (Persistencia de datos) -->
        <!-- ============================================ -->
        <!-- Motor principal de Entity Framework Core (ORM). Permite trabajar con la base de datos usando C# -->
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.8"/>
        <!-- Agrega soporte para bases de datos relacionales (tablas, relaciones, claves foráneas, etc.) -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.8"/>
        <!-- Paquete antiguo de diseño para EF Core Relational (prácticamente obsoleto) -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational.Design" Version="1.1.6"/>
        <!-- Herramientas de desarrollo para EF Core (migraciones y comandos dotnet ef) -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8"/>
        <!-- ================================ -->
        <!-- Proveedor de Base de Datos MySQL -->
        <!-- ================================ -->
        <!-- Permite que EF Core se comunique y genere consultas compatibles con MySQL -->
        <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.7"/>
        <!-- ========================== -->
        <!-- Formato de textos y fechas -->
        <!-- ========================== -->
        <!-- Convierte textos, fechas y números a formatos más legibles -->
        <PackageReference Include="Humanizer" Version="3.0.10"/>
        <!-- ================================ -->
        <!-- Documentación de la API (Swagger) -->
        <!-- ================================ -->
        <!-- Genera la interfaz Swagger para documentar y probar la API -->
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.0"/>
        <!-- Permite agregar anotaciones para mejorar la documentación Swagger -->
        <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="10.2.0"/>
        <!-- ======================== -->
        <!-- Seguridad - Contraseñas -->
        <!-- ======================== -->
        <!-- Genera hashes seguros para almacenar contraseñas -->
        <PackageReference Include="BCrypt.Net-Next" Version="4.2.0"/>
        <!-- ================= -->
        <!-- Seguridad - JWT -->
        <!-- ================= -->
        <!-- Crea y lee tokens JWT -->
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.18.0"/>
        <!-- Valida los tokens JWT enviados en cada petición -->
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8"/>
        <!-- Proporciona las clases necesarias para crear y validar tokens (claves, firmas y validaciones) -->
        <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.18.0"/>
        <!-- ================= -->
        <!-- Patrón Mediator -->
        <!-- ================= -->
        <!-- Implementa el patrón Mediator para separar la lógica del controlador en Commands y Queries -->
        <PackageReference Include="Cortex.Mediator" Version="3.1.2"/>

    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Iam\Resources\IamMessages.es.resx">
            <DependentUpon>IamMessages.cs</DependentUpon>
        </EmbeddedResource>

        <EmbeddedResource Update="Profiles\Resources\ProfilesMessages.es.resx">
            <DependentUpon>ProfilesMessages.cs</DependentUpon>
        </EmbeddedResource>

        <EmbeddedResource Update="Publishing\Resources\PublishingMessages.es.resx">
            <DependentUpon>PublishingMessages.cs</DependentUpon>
        </EmbeddedResource>
    </ItemGroup>

</Project>
